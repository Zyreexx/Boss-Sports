# Django Settings
DJANGO_SECRET_KEY=replace-with-strong-random-production-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
BACKEND_SERVICE_SECRET=replace-with-shared-hmac-secret-matching-nextjs
CORS_ALLOWED_ORIGINS=http://localhost:3000
SERVE_LOCAL_MEDIA=True
DJANGO_SECURE_SSL_REDIRECT=False

# Role assignment for Google OAuth signups (optional comma-separated emails)
OWNER_EMAILS=
STAFF_EMAILS=

# PostgreSQL Database Configuration (Required when DJANGO_DEBUG=False)
DATABASE_URL=
POSTGRES_DB=boss_pickleball
POSTGRES_USER=boss_user
POSTGRES_PASSWORD=replace-with-postgres-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis & Celery Configuration
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Durable Media Cloud Storage (AWS S3, Cloudflare R2, MinIO, or Supabase Storage)
# When configured on Render, staff uploads are stored permanently in cloud storage rather than ephemeral container disk
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=auto
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
