datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum BookingStatus {
  HELD
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum BookingSource {
  ONLINE
  PHONE
  WALKIN
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum UserRole {
  CUSTOMER
  STAFF
  REGISTRAR
  OWNER
}

// Pickleball Court Definition
model Court {
  id           String        @id @default(uuid())
  name         String
  description  String?
  hourlyRate   Decimal       @default(400.00) // ₹400 base rate from PRD
  isActive     Boolean       @default(true)
  bookings     Booking[]
  holds        SlotHold[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// Single Source of Truth Booking Model
model Booking {
  id             String         @id @default(uuid())
  courtId        String
  court          Court          @relation(fields: [courtId], references: [id])
  startTime      DateTime
  endTime        DateTime
  status         BookingStatus  @default(CONFIRMED)
  source         BookingSource  @default(ONLINE)
  customerName   String
  customerPhone  String
  customerEmail  String?
  totalPrice     Decimal        @default(400.00)
  paymentStatus  PaymentStatus  @default(PENDING)
  notes          String?
  cancellationReason String?
  createdById    String?
  payments       Payment[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([courtId, startTime, endTime])
}

// Temporary Hold during customer online checkout (10-minute expiry)
model SlotHold {
  id         String   @id @default(uuid())
  courtId    String
  court      Court    @relation(fields: [courtId], references: [id])
  startTime  DateTime
  endTime    DateTime
  sessionId  String   // Browser session/checkout token
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([courtId, expiresAt])
}

// Auditable Payment Ledger
model Payment {
  id                String        @id @default(uuid())
  bookingId         String?
  booking           Booking?      @relation(fields: [bookingId], references: [id])
  amount            Decimal
  status            PaymentStatus @default(PENDING)
  method            String        // 'RAZORPAY', 'UPI_COUNTER', 'CASH'
  razorpayOrderId   String?
  razorpayPaymentId String?
  createdAt         DateTime      @default(now())
}

// Comprehensive Activity / Audit Log (PRD Section 7)
model AuditLog {
  id        String   @id @default(uuid())
  actorId   String
  actorRole UserRole
  action    String   // 'CREATE_BOOKING', 'UPDATE_PRICE', 'CANCEL_BOOKING'
  details   Json
  createdAt DateTime @default(now())
}

