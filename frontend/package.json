    "tailwind-merge": "^2.5.4",
    "wrangler": "^3.114.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
