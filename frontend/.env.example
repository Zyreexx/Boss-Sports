# =========================================================================
# BOSS PICKLEBALL — PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this file to .env.local for local development, or configure these
# variables directly in your Vercel project settings.
# =========================================================================

# Django + PostgreSQL Backend Integration (Required in production)
DJANGO_API_URL=http://127.0.0.1:8000
BACKEND_SERVICE_SECRET=replace-with-shared-hmac-secret-matching-django
SESSION_SECRET=replace-with-strong-session-signing-secret

# Production App URL (e.g. https://bosspickleball.com or https://your-project.vercel.app)
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Google OAuth 2.0 Credentials (From Google Cloud Console)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Owner & Staff Role Authorization (Comma-separated emails, also configured on Django backend)
OWNER_EMAILS=owner@bosspickleball.com
STAFF_EMAILS=staff@bosspickleball.com,manager@bosspickleball.com

# Payment Gateway (Optional / Razorpay Production Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
