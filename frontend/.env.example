# =========================================================================
# BOSS SPORTS & FITNESS (BOSS PICKLEBALL) — ENVIRONMENT CONFIGURATION
# Copy this file to .env.local for local development, or add these variables
# in Cloudflare Pages / Vercel project environment settings.
# =========================================================================

# --- SUPABASE PRODUCTION DATABASE & STORAGE (Recommended for Cloudflare) ---
# Project URL & Public Anon Key from Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Service Role Secret Key (Server-side only — keep private, never expose in client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- CLOUDFLARE PAGES / PRODUCTION HOSTING ---
# Production App URL (e.g. https://boss-sports.pages.dev or your custom domain)
NEXT_PUBLIC_APP_URL=https://boss-sports.pages.dev
# Secret key for encrypting and signing session authentication cookies
SESSION_SECRET=replace-with-a-strong-random-64-character-secret

# --- VENUE MANUAL UPI PAYMENT CONFIGURATION ---
# The official UPI ID / VPA displayed to customers when paying online
NEXT_PUBLIC_VENUE_UPI_ID=bosssports@upi
NEXT_PUBLIC_VENUE_UPI_NAME=Boss Sports and Fitness
# Optional static QR image URL (e.g. /images/venue-upi-qr.png). Leave empty to use dynamic UPI QR.
NEXT_PUBLIC_VENUE_UPI_QR_URL=
# Expiry window in minutes for unapproved manual UPI bookings holding a slot
PENDING_PAYMENT_TTL_MINUTES=30

# --- ROLE AUTHORIZATION (STAFF & OWNER ACCESS) ---
# Comma-separated list of emails granted Owner & Staff privileges
OWNER_EMAILS=owner@boss.com,owner@bosspickleball.com
STAFF_EMAILS=staff@boss.com,manager@bosspickleball.com

# --- GOOGLE OAUTH 2.0 (Optional — for one-click Google Sign-In) ---
# Authorized Redirect URI in Google Cloud Console:
# https://boss-sports.pages.dev/api/auth/google/callback (or http://localhost:3000/api/auth/google/callback for dev)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- OPTIONAL: DJANGO BACKEND INTEGRATION (If running Django separately) ---
# DJANGO_API_URL=http://127.0.0.1:8000
# BACKEND_SERVICE_SECRET=replace-with-shared-hmac-secret-matching-django
