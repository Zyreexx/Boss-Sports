# =========================================================================
# BOSS PICKLEBALL — PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this file to .env.local for local development, or add these variables
# directly in your production hosting dashboard (e.g. Vercel, Railway, Render).
# =========================================================================

# Production App URL (e.g. https://bosspickleball.com or https://your-project.vercel.app)
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Google OAuth 2.0 Credentials (From Google Cloud Console)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Owner & Staff Role Authorization (Comma-separated emails)
# Users signing in with these Google emails will automatically get OWNER / STAFF roles:
OWNER_EMAILS=owner@bosspickleball.com
STAFF_EMAILS=staff@bosspickleball.com,manager@bosspickleball.com

# Payment Gateway (Optional / Razorpay Production Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

