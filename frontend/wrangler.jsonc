{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "boss-sports-and-fitness",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ]
,
  "main": "vinext/server/fetch-handler"
,
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_next/static/*",
      "!/*/_next/static/*"
    ]
  }
}
